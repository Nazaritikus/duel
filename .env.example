# Browser (public by design; data is protected by RLS)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: `mock` plays the generated mock catalog instead of Supabase (also the fallback
# when the two vars above are missing).
# VITE_CATEGORY_SOURCE=mock

# Scripts only (seed, grant-admin). Secret: never prefix with VITE_, never commit.
SUPABASE_SECRET_KEY=sb_secret_...
